# Server
PORT=4000

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudstorage
DB_PASSWORD=change_me
DB_NAME=cloudstorage

# Where files are actually stored.
# For the WSL demo this can be a local folder.
# Later, on the Raspberry Pi, point this at the mounted external HDD, e.g. /mnt/hdd/storage
STORAGE_ROOT=./storage

# Max upload size in MB
MAX_UPLOAD_MB=2048
